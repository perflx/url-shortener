
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
} //I guess it is a generated code from prisma that can be used by js, since provider = "prisma-client-js"

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} //DataBase where it takes data. provider - type of db. url - the url to the db


model User{ //User model that will be saved in db.
  id Int @id @default(autoincrement()) //id, integer, by default it is generated via autoincrement
  email String @unique //email string used for primary user identification, must be unique
  password String //password as string
  createdAt DateTime @default(now()) //time of user creation
  links Link[] @relation("LinkAuthor") //links created by the user, has relation in database to Link model named LinkAuthor
}

model Link{
  id Int @id @default(autoincrement()) //id, integer, by default it is generated via autoincrement
  shortCode String @unique //short link
  originalUrl String //original url
  clicks Int @default(0) //amount of clicks, the counter must be implemented in ts
  createdAt DateTime @default(now()) //time of creation
  authorId Int //id of author
  author User @relation("LinkAuthor", fields: [authorId], references: [id]) //relation to User model in db, by authorid in Link and id in User
}